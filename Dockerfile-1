# EvoLink v0.6 — Railway (ZIP presente na raiz do repositorio GitHub)
FROM node:22-alpine
WORKDIR /app

# Os arquivos da pasta public estao DENTRO do ZIP, nao na raiz do GitHub.
COPY . /tmp/evolink-repo/
RUN set -eu; \
    archive='/tmp/evolink-repo/EvoLink-Pokemon-Evolution-RPG-v0.6-Online.zip'; \
    test -f "$archive" || { echo 'ERRO: ZIP v0.6 ausente na raiz do GitHub.' >&2; exit 1; }; \
    mkdir -p /tmp/evolink-extracted; \
    busybox unzip -q "$archive" -d /tmp/evolink-extracted; \
    cp -R /tmp/evolink-extracted/evolink-pokemon-rpg/. /app/; \
    cp /tmp/evolink-repo/server.js /app/server.js; \
    cp /tmp/evolink-repo/app.js /tmp/evolink-repo/style.css /tmp/evolink-repo/sw.js /app/public/; \
    test -s /app/public/index.html || { echo 'ERRO: arquivo public/index.html ausente do aplicativo.' >&2; exit 1; }; \
    test -s /app/server.js || { echo 'ERRO: arquivo server.js ausente.' >&2; exit 1; }; \
    mkdir -p /app/data; \
    chown -R node:node /app; \
    rm -rf /tmp/evolink-repo /tmp/evolink-extracted

ENV NODE_ENV=production DATA_DIR=/app/data TRUST_PROXY=1 PORT=3000
EXPOSE 3000

# Garante porta 3000 e 0.0.0.0, mesmo se PORT=8080 vier de outra configuracao.
# O volume do Railway permanece montado em /app/data.
CMD ["node", "-e", "const fs=require('node:fs');const dir='/app/data';fs.mkdirSync(dir,{recursive:true});fs.chownSync(dir,1000,1000);process.setgid(1000);process.setuid(1000);process.env.PORT='3000';require('/app/server.js').createServer().listen(3000,'0.0.0.0',()=>console.log('EvoLink ouvindo na porta 3000'));" ]

